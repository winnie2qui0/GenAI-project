# Database
DATABASE_URL=postgresql://procurement:procurement@localhost:5432/procurement_db

# LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo

# Crawler settings
CRAWLER_DELAY_MIN=1
CRAWLER_DELAY_MAX=5
CRAWLER_TIMEOUT=30
USE_PROXY_POOL=false

# Cache
CACHE_TTL_HOURS=48

# Scoring weights
SCORING_WEIGHT_PRICE=0.30
SCORING_WEIGHT_DELIVERY=0.30
SCORING_WEIGHT_RATING=0.20
SCORING_WEIGHT_TRUST=0.20

# Application
APP_ENV=development
LOG_LEVEL=INFO
